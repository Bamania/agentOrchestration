# Copy this file to .env and fill in the values.
# .env is gitignored - never commit real keys. This file IS committed, as the template.

# Which provider test.js builds: openai | gemini
# (if the chosen provider has no key, test.js falls back to the fake model)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Prepends LoggingMiddleware to every agent's middleware chain (true/false)
AGENT_ENABLE_TELEMETRY=false
